#!/usr/bin/env bash
# Prepara il collegamento all'agente Copilot Studio: ambiente Python isolato in .venv con il
# client ufficiale Microsoft, poi verifica la configurazione. Il login lo fai tu:
#   ruby jarvis.rb --copilot-login
set -euo pipefail
cd "$(dirname "$0")/.."
command -v python3 >/dev/null || { echo "❌ python3 non trovato (brew install python)"; exit 1; }
[[ -x .venv/bin/python ]] || python3 -m venv .venv
.venv/bin/pip install -q --upgrade pip
.venv/bin/pip install -q "microsoft-agents-copilotstudio-client==1.9.0" "msal==1.39.0" "msal-extensions==1.3.1"
echo "✅ client Copilot installato in .venv"
ruby jarvis.rb --copilot-status || true
